[configuration]

entry_symbol = "mujoco_library_init"
compatibility_minimum = "4.2"

[libraries]

windows.debug.x86_64   = "res://addons/mujoco/bin/libgodot_mujoco.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "res://addons/mujoco/bin/libgodot_mujoco.windows.template_release.x86_64.dll"
linux.debug.x86_64     = "res://addons/mujoco/bin/libgodot_mujoco.linux.template_debug.x86_64.so"
linux.release.x86_64   = "res://addons/mujoco/bin/libgodot_mujoco.linux.template_release.x86_64.so"

[dependencies]

windows.debug.x86_64   = { "res://addons/mujoco/bin/libmujoco.dll" : "" }
windows.release.x86_64 = { "res://addons/mujoco/bin/libmujoco.dll" : "" }
